// AIMS VM 수집 에이전트 — Grafana Alloy (Tumblebug VM, docs/11 §5.5). 로그는 Loki 로, 지표는 Thanos Receive 로 보낸다.
//
// 백엔드가 Tumblebug 원격 명령으로 /etc/aims-alloy/config.alloy 에 쓰고 systemd(aims-alloy)로 띄운다. 모든 VM 에 같은 내용이며,
// VM 마다 다른 값은 /etc/aims-alloy/alloy.env 에서 온다(같은 설치 명령이 함께 쓴다).
//   TB_NS / TB_INFRA / TB_NODE  Tumblebug Namespace·Infra·Node id. 로그와 VM 을 묶는 조인 키라 글자까지 같아야 한다.
//   LOKI_PUSH_URL               AIMS 수집 서버의 Loki push 주소(VM 에서 보이는 주소)
//   AIMS_TARGETS_URL            AIMS 백엔드의 수집 대상 목록 API(VM 에서 보이는 주소)
//   REMOTE_WRITE_URL            Thanos Receive remote_write 주소(VM 에서 보이는 주소)
//
// 컨테이너가 아니라 호스트 프로세스라 /host 접두어가 없다 — 목록의 __path__ 를 그대로 읽고 filename 도 그대로다.
// 라벨 계약(tb_ns, tb_infra, tb_node, job, filename)은 AIMS 가 조회에 쓰는 키이므로 바꾸지 않는다.
// 지표도 같은 tb_ns·tb_infra·tb_node 를 붙인다 — 자원 탐색기는 VM 지표를 IP 가 아니라 이 세 라벨로 고른다(docs/07).

// ── 시스템 로그 (정적) ──────────────────────────────────────
// Debian/Ubuntu 와 RHEL 계열 경로를 함께 둔다. 없는 파일은 그냥 매칭되지 않는다(aims.agent.remote-static-log-paths 와 같은 목록).

loki.source.file "syslog" {
  targets = [
    { __address__ = "localhost", __path__ = "/var/log/syslog",   job = "syslog" },
    { __address__ = "localhost", __path__ = "/var/log/messages", job = "syslog" },
  ]
  forward_to = [loki.write.default.receiver]

  file_match {
    enabled = true
  }
}

loki.source.file "auth" {
  targets = [
    { __address__ = "localhost", __path__ = "/var/log/auth.log", job = "auth-log" },
    { __address__ = "localhost", __path__ = "/var/log/secure",   job = "auth-log" },
  ]
  forward_to = [loki.write.default.receiver]

  file_match {
    enabled = true
  }
}

loki.source.file "kern" {
  targets = [{
    __address__ = "localhost",
    __path__    = "/var/log/kern.log",
    job         = "kern-log",
  }]
  forward_to = [loki.write.default.receiver]

  file_match {
    enabled = true
  }
}

// ── 포털에서 등록한 수집 서비스 파일 (동적 대상, 백엔드에서 가져옴) ──
// 응답: [{ "targets": ["localhost"], "labels": { "__path__": 경로, "job": "collect/<서비스>", "service_id": "<id>" } }]
// VM 식별은 Tumblebug 키 세 개다(별도 토큰 없음). Tumblebug id 는 영숫자·-·_·. 만 쓰므로 그대로 쿼리에 넣는다.

discovery.http "collect" {
  url              = string.format("%s?tbNs=%s&tbInfra=%s&tbNode=%s", sys.env("AIMS_TARGETS_URL"), sys.env("TB_NS"), sys.env("TB_INFRA"), sys.env("TB_NODE"))
  refresh_interval = "30s"
}

loki.source.file "collect" {
  targets    = discovery.http.collect.targets
  forward_to = [loki.write.default.receiver]

  file_match {
    enabled = true
  }
}

// ── Loki 전송 ───────────────────────────────────────────────

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")
  }
  // 이 VM 에서 나가는 모든 로그 스트림에 붙는 식별 라벨 — 자원 탐색기 VM 로그 탭이 이 세 라벨로 고른다.
  external_labels = {
    tb_ns    = sys.env("TB_NS"),
    tb_infra = sys.env("TB_INFRA"),
    tb_node  = sys.env("TB_NODE"),
  }
}

// ── 지표 (node_exporter·dcgm-exporter → Thanos Receive) ──────
// VM 안 exporter 를 15초마다 읽는다(백엔드 수집 주기 가정과 같게). instance 는 "<TB_NODE>:<포트>" —
// 모든 VM 이 127.0.0.1 을 읽으므로 주소 그대로 두면 VM 끼리 같은 값이 된다. job 이름은 백엔드 수집 대상 job 과 같게 둔다.

prometheus.scrape "node" {
  targets         = [{ __address__ = "127.0.0.1:9100", instance = string.format("%s:9100", sys.env("TB_NODE")) }]
  job_name        = "node-exporter"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.aims.receiver]
}

// AIMS:GPU:BEGIN — GPU 가 없거나 dcgm-exporter 를 띄우지 못하면 설치 스크립트가 이 구간을 지운다
prometheus.scrape "dcgm" {
  targets         = [{ __address__ = "127.0.0.1:9400", instance = string.format("%s:9400", sys.env("TB_NODE")) }]
  job_name        = "gpu-metrics"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.aims.receiver]
}
// AIMS:GPU:END

prometheus.remote_write "aims" {
  endpoint {
    url = sys.env("REMOTE_WRITE_URL")
  }
  // up 을 포함한 모든 지표에 붙는다 — 트리의 수집 상태(up{tb_node!=""})와 패널 조회가 이 세 라벨을 쓴다.
  external_labels = {
    tb_ns    = sys.env("TB_NS"),
    tb_infra = sys.env("TB_INFRA"),
    tb_node  = sys.env("TB_NODE"),
  }
}
