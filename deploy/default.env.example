# VM 의 /etc/default/aims-cloud-backend 로 복사해서 사용한다.
#   sudo cp default.env.example /etc/default/aims-cloud-backend
#
# 이 파일은 systemd 가 읽는다. 따옴표 없이 KEY=VALUE 로만 쓴다.

SPRING_PROFILES_ACTIVE=vm

# 힙은 VM 스펙에 맞춰 조정한다. MaxRAMPercentage 는 컨테이너/소형 VM 모두에서 무난하다.
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom -Dfile.encoding=UTF-8

# --- 원격 디버깅 (필요할 때만 주석 해제) ---
# 반드시 address 를 127.0.0.1 로 묶어 둔다. 0.0.0.0 으로 열면 인증 없는
# 임의 코드 실행 통로가 되므로, 접속은 SSH 터널로만 한다:
#   ssh -L 5005:127.0.0.1:5005 <user>@<vm>
#
# JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseG1GC -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=127.0.0.1:5005

# --- 알람 Email 전송 (docs/09 A.5.4) ---
# 사내 아마란스(그룹웨어) SMTP 를 쓴다(2026-09-14 박형탁 안내, 2026-09-16 로컬 발송 확인). 그룹웨어 계정 이메일/비밀번호로 인증한다.
# 개인 계정 대신 발송 전용 계정(예: aims-noreply@innogrid.com)을 그룹웨어에 만들어 넣는 것을 권장한다.
# 비우면 JavaMailSender 가 만들어지지 않아 Email 전송은 "메일 서버 미구성" FAILED 로 기록되고 평가·이력은 그대로 동작한다.
# SPRING_MAIL_HOST=wblock.innogrid.com
# SPRING_MAIL_PORT=25
# SPRING_MAIL_USERNAME=<그룹웨어 이메일>
# SPRING_MAIL_PASSWORD=<그룹웨어 비밀번호>
# 발신자(From) — 아마란스는 인증 계정과 다른 From 을 거부할 수 있으니 USERNAME 과 같게 둔다
# AIMS_ALARM_MAIL_FROM=<그룹웨어 이메일>
# 인증·STARTTLS 는 기본 true. 인증 없는 릴레이나 평문 SMTP 를 쓸 때만 false
# AIMS_MAIL_SMTP_AUTH=true
# AIMS_MAIL_SMTP_STARTTLS=true
# 자체 서명 인증서로 "unable to find valid certification path" 가 나면 신뢰 호스트 지정
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_TRUST=wblock.innogrid.com
# 전송 파이프라인 끄기(평가·이력만 남김)
# AIMS_ALARM_NOTIFICATION_ENABLED=false

# --- Tumblebug VM 수집 에이전트 설치 (docs/11 §5.5) ---
# VM 의 Alloy 가 직접 부르는 주소라 VM 에서 보이는 주소로 쓴다. 비우면 VM 설치 API 가 503 이다.
# 목록 API 는 인증이 없으므로 백엔드 8080 은 VM 대역에서만 닿게 방화벽을 둔다.
# AIMS_AGENT_VM_LOKI_PUSH_URL=http://<수집서버>:3100/loki/api/v1/push
# AIMS_AGENT_VM_TARGETS_URL=http://<백엔드>:8080/api/v1/agent/targets
# AIMS_AGENT_VM_REMOTE_WRITE_URL=http://<수집서버>:19291/api/v1/receive
# AIMS_AGENT_VM_DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.2.3-4.1.3-ubuntu22.04
