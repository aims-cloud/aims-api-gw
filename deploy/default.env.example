# VM 의 /etc/default/aims-cloud-backend 로 복사해서 사용한다.
#   sudo cp default.env.example /etc/default/aims-cloud-backend
#
# 이 파일은 systemd 가 읽는다. 따옴표 없이 KEY=VALUE 로만 쓴다.

SPRING_PROFILES_ACTIVE=vm

# 힙은 VM 스펙에 맞춰 조정한다. MaxRAMPercentage 는 컨테이너/소형 VM 모두에서 무난하다.
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom -Dfile.encoding=UTF-8

# --- 원격 디버깅 (필요할 때만 주석 해제) ---
# 반드시 address 를 127.0.0.1 로 묶어 둔다. 0.0.0.0 으로 열면 인증 없는
# 임의 코드 실행 통로가 되므로, 접속은 SSH 터널로만 한다:
#   ssh -L 5005:127.0.0.1:5005 <user>@<vm>
#
# JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseG1GC -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=127.0.0.1:5005

# --- 알람 Email 전송 (docs/09 A.5.4) ---
# 발송용 전용 계정을 받아 넣는다. Google/Microsoft 는 2단계 인증 계정이면 앱 비밀번호가 필요하다.
# 비우면 JavaMailSender 가 만들어지지 않아 Email 전송은 "메일 서버 미구성" FAILED 로 기록되고 평가·이력은 그대로 동작한다.
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=aims-alarm@innogrid.com
# SPRING_MAIL_PASSWORD=<앱 비밀번호>
# 발신자(From) 표시 주소. 비우면 계정 기본값
# AIMS_ALARM_MAIL_FROM=aims-alarm@innogrid.com
# 전송 파이프라인 끄기(평가·이력만 남김)
# AIMS_ALARM_NOTIFICATION_ENABLED=false
