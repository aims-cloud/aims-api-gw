# AIMS 노드 로그 수집 에이전트 — 노드별 설정. 이 파일을 alloy.env 로 복사해 값을 채운다.

# 이 노드의 node_exporter 를 Prometheus 가 긁는 주소(host:port). AIMS 자산관리에 등록된 scrape 주소와 글자까지 같아야 한다.
NODE_INSTANCE=10.0.0.21:9100

# 이 노드가 속한 마이크로 데이터센터 id(AIMS 자산관리의 MDC id).
MDC_ID=mdc-01

# AIMS 수집 서버의 Loki push 주소.
LOKI_PUSH_URL=http://<AIMS 수집서버>:3100/loki/api/v1/push

# AIMS 백엔드의 수집 대상 목록 API. 노드 식별은 위 NODE_INSTANCE 값으로 한다.
AIMS_TARGETS_URL=http://<AIMS 백엔드>:8080/api/v1/agent/targets
